{
  "name": "@printemps-tokyo/trendcat",
  "version": "0.1.0",
  "description": "Aggregate what's trending now from Hacker News, Reddit, Wikipedia, Hatena, and Google News. Zero-dependency CLI.",
  "type": "module",
  "license": "MIT",
  "author": "printemps.tokyo <develop@printemps.tokyo>",
  "homepage": "https://github.com/printemps-tokyo/trendcat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/printemps-tokyo/trendcat.git"
  },
  "bugs": {
    "url": "https://github.com/printemps-tokyo/trendcat/issues"
  },
  "keywords": [
    "trends",
    "trending",
    "hacker-news",
    "reddit",
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "trendcat": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "live-check": "node scripts/live-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
